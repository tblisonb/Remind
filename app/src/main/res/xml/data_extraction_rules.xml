<?xml version="1.0" encoding="utf-8"?>
<!-- Back up tasks, but never the sync settings: they contain the server access token. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sync.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sync.xml" />
    </device-transfer>
</data-extraction-rules>
